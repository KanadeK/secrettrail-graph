<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>SecretTrail Graph report</title>
<style>body{font:16px system-ui,sans-serif;margin:2rem auto;max-width:1100px;color:#17212b;background:#f8fafc}header{border-left:6px solid #0f766e;padding-left:1rem}article{background:#fff;margin:1rem 0;padding:1rem;border-radius:.5rem;box-shadow:0 1px 4px #cbd5e1}.active{color:#b91c1c}.resolved{color:#047857}code{background:#e2e8f0;padding:.15rem .3rem}li{margin:.25rem 0}</style></head>
<body><header><h1>SecretTrail Graph</h1><p>Offline, sanitized propagation report. Generated {{ report.generated_at }}.</p></header>
<p>{{ report.timelines|length }} timelines from {{ report.source_count }} imported findings.</p>
{% for timeline in report.timelines %}<article><h2><code>{{ timeline.fingerprint }}</code> · <span class="{{ timeline.status }}">{{ timeline.status }}</span></h2><p>Masked sample: <code>{{ timeline.masked_secret }}</code>. Root-cause candidate: <strong>{{ timeline.root_cause_candidate }}</strong>.</p><p>First seen {{ timeline.first_seen }}; last seen {{ timeline.last_seen }}; recurrences {{ timeline.recurrence_count }}.</p><h3>Propagation</h3><ol>{% for edge in timeline.propagation %}<li>{{ edge.from_location }} → {{ edge.to_location }} ({{ edge.relationship }})</li>{% endfor %}</ol><h3>Repair checklist</h3><ul>{% for item in timeline.checklist %}<li>{{ item }}</li>{% endfor %}</ul></article>{% endfor %}
<script id="secrettrail-report" type="application/json">{{ report_json }}</script></body></html>
